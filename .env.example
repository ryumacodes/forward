# Optional public ElevenLabs agent ID for development voice sessions.
# Never put an ElevenLabs API key in a VITE_ variable.
VITE_ELEVENLABS_AGENT_ID=

# Fill these in together when ready. Blank values keep demo mode enabled.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Set these as Supabase Edge Function secrets. They are not read by Vite.
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-5.6-luna
OPENAI_DISCOVERY_MODEL=gpt-5.6-terra
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Free ABN Lookup web-services GUID. Register at abr.business.gov.au.
ABR_AUTH_GUID=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_CALLBACK_NUMBER=+61390000000
CALLING_BUSINESS_NAME=
ELEVENLABS_WEBHOOK_SECRET=
# Server-only provider secrets belong in Supabase Edge Function secrets, never VITE_*.
