# Optional public ElevenLabs agent ID for development voice sessions.
# Never put an ElevenLabs API key in a VITE_ variable.
VITE_ELEVENLABS_AGENT_ID=

# Fill these in together when ready. Blank values keep demo mode enabled.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional explicitly-authorised login for live CDP E2E testing. Keep these
# values only in an ignored local environment file or CI secret store.
E2E_EMAIL=
E2E_PASSWORD=

# Set these as Supabase Edge Function secrets. They are not read by Vite.
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-5.6-luna
OPENAI_DISCOVERY_MODEL=gpt-5.6-terra
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Free ABN Lookup web-services GUID. Register at abr.business.gov.au.
ABR_AUTH_GUID=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_AGENT_ID=
ELEVENLABS_OWNER_NOTIFICATION_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_CALLBACK_NUMBER=+61390000000
CALLING_BUSINESS_NAME=
ELEVENLABS_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=SourcePilot <procurement@example.com>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=+61390000000
OWNER_APPROVAL_PHONE=
OWNER_NOTIFICATION_EMAIL=

# Guarded real-provider smoke test. Keep recipients in an ignored .env file.
LIVE_COMMUNICATIONS_CONFIRM=
LIVE_TEST_EMAILS=
LIVE_TEST_PHONE=
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
APP_BASE_URL=https://your-production-domain.example
# Server-only provider secrets belong in Supabase Edge Function secrets, never VITE_*.
